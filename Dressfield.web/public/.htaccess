# Serve pre-rendered Next.js static export on Apache/Hostinger
# Handles trailing-slash URLs → index.html

RewriteEngine On
ErrorDocument 404 /404.html

# Redirect legacy product query URLs to canonical, indexable product detail pages.
# /product/?slug=foo  ->  /products/foo/  (the statically pre-rendered, SEO-friendly route)
RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^product/?$ /products/%1/? [R=301,L,NE]
RewriteRule ^product/?$ /products/ [R=301,L]

# If the request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Strip trailing slash for file lookup (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^(.+)/$ /$1/index.html [L]

# Route extensionless URLs to their index.html
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

# Fallback to 404 page with a real HTTP 404 status
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

# Cache static assets for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Stronger cache-control: Next.js hashed assets under /_next/static are immutable.
# Browsers can keep them forever and never revalidate, which crushes repeat-visit TTFB.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2|woff|ttf|otf|svg|jpe?g|png|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always revalidate so deploys take effect immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Enable Brotli/Gzip compression — PageSpeed's "enormous network payloads" and
# "document request latency" both improve when text assets are compressed.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml application/xml+rss application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/xml+rss application/rss+xml image/svg+xml font/woff font/woff2
</IfModule>
