# Hostinger FTP deploy credentials.
# Copy this file to ".env.deploy" and fill in your real values.
# ".env.deploy" is gitignored (matched by .env*) and is NEVER committed.
#
# Find these in hPanel → Files → FTP Accounts.

HOSTINGER_FTP_HOST=ftp.dressfield.ge
HOSTINGER_FTP_USER=your-ftp-username
HOSTINGER_FTP_PASSWORD=your-ftp-password

# Web root for the domain. IMPORTANT: on Hostinger, a domain set up under
# "domains" serves from /domains/<domain>/public_html — NOT the account-level
# /public_html (uploading there has no effect on the live site). dressfield.ge
# serves from the path below.
HOSTINGER_FTP_REMOTE_DIR=/domains/dressfield.ge/public_html

# Optional advanced settings (defaults shown):
# HOSTINGER_FTP_PORT=21
# HOSTINGER_FTP_SECURE=true              # use FTPS (explicit TLS)
# HOSTINGER_FTP_REJECT_UNAUTHORIZED=false
# HOSTINGER_FTP_CLEAN=false              # set true to wipe the remote dir before upload
